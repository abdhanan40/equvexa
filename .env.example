# Copy to .env.local and adjust per environment. Never commit real secrets.
#
# These values are for `next dev` and `next start`. On Cloudflare the same
# settings are Worker variables and secrets (see README, "Deploying to
# Cloudflare"). Before any Cloudflare build (`npm run preview`, `deploy` or
# `upload`), .env files must hold no secrets: the build copies them into the
# Worker. Use .dev.vars (see .dev.vars.example) for local Worker previews.

# Public base URL of the site, used for canonical URLs, the sitemap and social
# metadata. Read at build time. Production: https://equvexaindustries.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Inquiry delivery (server only, never exposed to the browser) ---

# Resend API key (https://resend.com). Leave empty here; set it in .env.local.
RESEND_API_KEY=

# Sender of the inquiry emails: an address on a domain verified in Resend.
# The production sender on equvexaindustries.com has not been chosen yet.
INQUIRY_FROM_EMAIL=

# Where inquiries are delivered. Defaults to the address in src/config/site.ts.
INQUIRY_TO_EMAIL=

# Key for the hashed visitor ids used by rate limiting. Optional here (a random
# key is used per server process); required on Cloudflare. Use a random string
# of at least 32 characters, e.g. from `openssl rand -hex 32`.
VISITOR_HASH_SECRET=
