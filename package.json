{
  "name": "equvexa",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p cloudflare",
    "cf:check-env": "node scripts/assert-no-env-secrets.mjs",
    "preview": "npm run cf:check-env && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run cf:check-env && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "npm run cf:check-env && opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types cloudflare/cloudflare-env.d.ts --env-interface CloudflareEnv --include-runtime=false"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "clsx": "^2.1.1",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260918.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.135.0"
  }
}
